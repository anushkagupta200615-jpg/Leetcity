# ── Optional: shared-world backend (Supabase) ───────────────────────────────
# Leave these unset and LeetCity runs exactly as it does offline: a synthetic
# world with no global leaderboard. Set both and the world fills with REAL
# users and the 🏆 Ranks leaderboard turns on.
#
# 1. Create a free project at https://supabase.com
# 2. Run supabase-schema.sql in the project's SQL Editor
# 3. Project Settings → API → copy the values below
# 4. Copy this file to `.env` (and add the same two vars in Vercel → Settings → Environment Variables)

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
